#!/system/bin/sh

# 定义 ANSI 转义码
ESC_SEQ="\x1b["
RESET_SEQ="${ESC_SEQ}0m"
COLOR_SEQ="${ESC_SEQ}36;5;"

# 定义颜色代码
COLOR_RED="${COLOR_SEQ}9m"
COLOR_GREEN="${COLOR_SEQ}10m"
COLOR_YELLOW="${COLOR_SEQ}11m"
COLOR_BLUE="${COLOR_SEQ}12m"

BLUE='\033[0;34m'
YELLOW='\033[36;1m'
NC='\033[0m'
echo -e "${COLOR_YELLOW}→ 水原千鹤驱动${RESET_SEQ}"
echo -e "${COLOR_YELLOW}→ 下方出现 Invalid argument 再试一次${RESET_SEQ}"

if [ "$(id -u)" != "0" ]; then
  echo -e "${BLUE}错误提示:${NC} 请使用 root 权限运行此脚本。" 1>&2
  exit 1
fi


file_path="/dev/TH520"
    sleep 0.5
   
if [ -e "$file_path" ]; then
    echo "${COLOR_YELLOW}→ 驱动已刷入，无需重复刷入"
    exit 0
fi

